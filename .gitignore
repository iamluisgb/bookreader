# Secrets — nunca commitear
.env
.env.*
!.env.example

# Dependencias y artefactos
node_modules/
test-results/
playwright-report/
playwright/.cache/
# Scratch del MCP del navegador (volcados de consola y snapshots de sesiones de depuración)
.playwright-mcp/

# Evals (docs/EVALS.md): los libros fixture se descargan (evals/fetch-fixtures.mjs)
# y los runs son salidas locales — solo se versionan los scripts y el README.
evals/fixtures/*
!evals/fixtures/README.md
evals/runs/

# Estado local de wrangler (D1 local, caches del dev server)
.wrangler/

# Salida de build para Cloudflare Pages (scripts/build-pages.mjs)
dist/

# Toolchain de la ayuda (MkDocs): el venv es local, el HTML generado (help/, es/ayuda/)
# sí se versiona porque el deploy sale de HEAD. Ver scripts/build-help.mjs.
.venv-docs/
docs-help/site-en/
docs-help/site-es/

# Vídeos y capturas de emulador (se regeneran)
reels/
.em-shots/

# Baterías con la biblioteca personal (IA10): fuera del repo público
evals/private/

docs-help/__pycache__/
