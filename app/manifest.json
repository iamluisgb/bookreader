{
  "name": "BookReader",
  "short_name": "BookReader",
  "description": "Lector de EPUB y PDF con un agente de IA orientado a objetivos",
  "lang": "es",
  "dir": "ltr",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#111418",
  "theme_color": "#111418",
  "categories": [
    "books",
    "education",
    "productivity"
  ],
  "icons": [
    {
      "src": "icons/icon.svg",
      "type": "image/svg+xml",
      "sizes": "any",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            ".bookreader",
            ".epub",
            ".pdf",
            "application/zip",
            "application/epub+zip",
            "application/pdf",
            "application/octet-stream"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-bookreader": [
          ".bookreader"
        ],
        "application/epub+zip": [
          ".epub"
        ],
        "application/pdf": [
          ".pdf"
        ]
      },
      "launch_type": "single-client"
    }
  ]
}
